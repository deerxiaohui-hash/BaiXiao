.env
backend/.env
cloudflared-config.yml
start-with-tunnel.bat
*.token
*.key
*.secret

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl

# 虚拟环境
.venv/
venv/
env/
ENV/

# 测试/覆盖率
.pytest_cache/
.coverage
htmlcov/
.tox/
*.log

# ============================================
