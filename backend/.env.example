# Longcat API 配置
LONGCAT_API_KEY=your_api_key_here
LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1
LONGCAT_MODEL=LongCat-2.5-Preview

# 检索配置（hybrid = 语义向量+BM25 混合，tfidf = 纯词面回退）
RETRIEVAL_BACKEND=hybrid
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
MIN_SIMILARITY_HYBRID=0.35
MIN_SIMILARITY_TFIDF=0.05
